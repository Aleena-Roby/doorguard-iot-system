# =====================================================================
# DoorGuard — Root Environment Variables Template
# =====================================================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=doorguard
POSTGRES_PORT=5432

# Backend Service Configuration
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/doorguard
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/doorguard_test
FLASK_ENV=development
SECRET_KEY=doorguard_dev_secret_key_change_in_prod
PORT=5000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Monitoring Defaults
ALERT_DEFAULT_THRESHOLD_SECONDS=10
HEARTBEAT_TIMEOUT_SECONDS=30
DEFAULT_DEVICE_ID=esp32_door_sensor_01

# Frontend Configuration
VITE_API_BASE_URL=

