# DoorGuard Backend Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=doorguard_local_secret_key_change_in_prod

# PostgreSQL Connection (Psycopg 3)
# Local Docker:
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/doorguard
# Cloud Supabase (Transaction Pooler - Port 6543):
# DATABASE_URL=postgresql://postgres.cdidxtqahszehqhfepyg:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

TEST_DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/doorguard_test

# Supabase API Credentials
SUPABASE_URL=https://cdidxtqahszehqhfepyg.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Server configuration
PORT=5000
HOST=0.0.0.0

# CORS Allowed Origins
CORS_ORIGINS=*

# Monitoring and Alerts defaults
ALERT_DEFAULT_THRESHOLD_SECONDS=10
HEARTBEAT_TIMEOUT_SECONDS=30
DEFAULT_DEVICE_ID=esp32_main_gate
