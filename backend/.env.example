# DoorGuard Backend Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=doorguard_local_secret_key_change_in_prod

# PostgreSQL Connection (Psycopg 3)
# Local Docker:
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/doorguard
# Cloud Supabase (Transaction Pooler - Port 6543 or Direct - Port 5432):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/doorguard_test

# Server configuration
PORT=5000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated or * for development)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Monitoring and Alerts defaults
ALERT_DEFAULT_THRESHOLD_SECONDS=10
HEARTBEAT_TIMEOUT_SECONDS=30
DEFAULT_DEVICE_ID=esp32_door_sensor_01

